# ─────────────────────────────────────────────────────────────
# ForStore / Cafe Game Store - Production Environment Configuration
# Copy this file to .env.local for development or set these variables
# in your hosting platform (Vercel, Railway, AWS, Docker, etc.)
# ─────────────────────────────────────────────────────────────

# Database Active Environment Mode: "demo" | "dev" | "prod"
MONGODB_ENV=prod

# Production MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cafe-game-store-prod?retryWrites=true&w=majority

# Optional Multi-Environment Atlas Targets
MONGODB_URI_PROD=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cafe-game-store-prod?retryWrites=true&w=majority
MONGODB_URI_DEV=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cafe-game-store-dev?retryWrites=true&w=majority
MONGODB_URI_DEMO=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cafe-game-store-demo?retryWrites=true&w=majority

# Auth Session HMAC Signing Key (Use a strong 64-char random hex string)
SESSION_SECRET=change_me_to_a_random_secure_hex_key_for_production
